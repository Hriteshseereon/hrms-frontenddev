# ---------------------------------------------------------------------------
# Seereon HRMS web — environment variables
# Copy to .env.local for development. VITE_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the backend API (Django REST / FastAPI gateway). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Data source for the screens:
#   mock → built-in demo data kept in the browser (no backend needed; default)
#   api  → call the backend through src/services/api
VITE_DATA_MODE=mock

# Request timeout for API calls, in milliseconds.
VITE_API_TIMEOUT_MS=20000

# Public URL of this web app (used in e-mails / share links).
VITE_APP_URL=http://localhost:3000
